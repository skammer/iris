{:paths ["src" "resources"]
 :deps {org.clojure/clojure {:mvn/version "1.11.1"}
        org.clojure/core.async {:mvn/version "1.6.681"}
        org.clojure/data.json {:mvn/version "2.5.1"}
        clj-http/clj-http {:mvn/version "3.12.3"}
        cheshire/cheshire {:mvn/version "5.11.0"}
        hiccup/hiccup {:mvn/version "2.0.0-RC3"}
        io.replikativ/datahike {:mvn/version "0.6.1599"}
        org.xerial/sqlite-jdbc {:mvn/version "3.46.1.3"}}
 :aliases {:dev {:extra-paths ["dev"]
                 :extra-deps {org.clojure/tools.namespace {:mvn/version "1.3.0"}
                              cider/cider-nrepl {:mvn/version "0.30.0"}}}
           :test {:extra-paths ["test"]}
           :legacy {:extra-paths ["legacy_src"]
                    :extra-deps {org.clojars.quoll/asami {:mvn/version "2.2.4"}}}
           :uberjar {:deps {io.github.clojure/tools.build {:mvn/version "0.10.5"}}
                     :ns-default build}}}
